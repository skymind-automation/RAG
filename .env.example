# Postgres (must have the `vector` extension available)
DELTA_RAG_DB_NAME=delta_rag
DELTA_RAG_DB_USER=delta
DELTA_RAG_DB_PASSWORD=delta
DELTA_RAG_DB_HOST=127.0.0.1
DELTA_RAG_DB_PORT=5432

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Embeddings: "voyage" (production) or "hashing" (offline/deterministic, dev + CI only)
RAG_EMBEDDING_BACKEND=hashing
RAG_EMBEDDING_MODEL=voyage-3-large
RAG_EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# Optional: answer synthesis on top of retrieval
ANTHROPIC_API_KEY=
RAG_SYNTHESIS_MODEL=claude-opus-5
RAG_MIN_CONFIDENCE=0.25

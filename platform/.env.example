# ─── Delta ITSM platform configuration ─────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Every variable is read on the
# server; only NEXT_PUBLIC_* ever reaches the browser.

# PostgreSQL 16 with the pgvector extension available.
# DATABASE_URL may point at a pooler (PgBouncer / Prisma Accelerate);
# DIRECT_DATABASE_URL must be a direct connection (used for migrations).
DATABASE_URL=postgresql://itsm:itsm@127.0.0.1:5432/itsm
DIRECT_DATABASE_URL=postgresql://itsm:itsm@127.0.0.1:5432/itsm
# Integration tests use a separate database whose name must contain "test".
TEST_DATABASE_URL=postgresql://itsm:itsm@127.0.0.1:5432/itsm_test

# Auth.js — generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Only when running behind a proxy you control that sets Host correctly.
AUTH_TRUST_HOST=true
# Set to 0 when NOT behind a proxy that overwrites X-Forwarded-For; client
# IPs are then recorded as unknown instead of attacker-controlled.
TRUST_PROXY=1

# Redis — rate limiting now; queues (BullMQ) and real-time fan-out later.
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (AWS S3, Cloudflare R2) — Phase 2 attachments.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers — Phase 6/7. Keys stay server-side; never prefix with NEXT_PUBLIC_.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Email — Phase 4 (resend | postmark | console).
EMAIL_PROVIDER=console
RESEND_API_KEY=
POSTMARK_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Observability
LOG_LEVEL=info
PRISMA_LOG_QUERIES=0
